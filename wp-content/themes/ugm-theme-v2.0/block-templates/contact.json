  "content": "<!-- wp:columns {\"style\":{\"spacing\":{\"padding\":{\"top\":\"40px\",\"right\":\"0\",\"bottom\":\"12px\",\"left\":\"0\"}}}} -->\n<div class=\"wp-block-columns\" style=\"padding-top:40px;padding-right:0;padding-bottom:12px;padding-left:0\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:html -->\n<iframe width=\"100%\" height=\"350\" frameborder=\"0\" scrolling=\"no\" marginheight=\"0\" marginwidth=\"0\" src=\"https://www.openstreetmap.org/export/embed.html?bbox=110.37502527236938%2C-7.770419346987133%2C110.38210630416872%2C-7.7655612619726&amp;layer=mapnik&amp;marker=-7.76799031150372%2C110.37856578826904\" style=\"border: 1px solid black\"></iframe>\n<!-- /wp:html -->\n\n<!-- wp:spacer {\"height\":\"32px\"} -->\n<div style=\"height:32px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:heading {\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"12px\"}}},\"textColor\":\"ugm-primary-bg\"} -->\n<h2 class=\"has-ugm-primary-bg-color has-text-color\" style=\"margin-bottom:12px\">Universitas Gadjah Mada</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"12px\"}}}} -->\n<p style=\"margin-bottom:12px\">Bulaksumur, Yogyakarta, Indonesia 55281</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"12px\"}}}} -->\n<p style=\"margin-bottom:12px\"><a href=\"mailto:info@ugm.ac.id\">info@ugm.ac.id</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"12px\"}}}} -->\n<p style=\"margin-bottom:12px\"><a href=\"tel:+622746492599\">+62 (274) 6492599</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"12px\"}}}} -->\n<p style=\"margin-bottom:12px\"><a href=\"tel:+628112869988\">+62 811 2869 988</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-column\"><!-- wp:ugm-blocks/section-title {\"id\":\"ugm-blocks-section-title-a00cf888-248f-4a\",\"content\":\"Tinggalkan Pesan\",\"headingStyle\":2} -->\n<div class=\"wp-block-ugm-blocks-section-title\" style=\"margin-bottom:20px\"><div class=\"ugm-blocks-block-heading align-left style-2\"><span class=\"line-before\"></span><h2>Tinggalkan Pesan</h2><span class=\"line-after\"></span></div></div>\n<!-- /wp:ugm-blocks/section-title -->\n\n<!-- wp:shortcode /--></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->"
